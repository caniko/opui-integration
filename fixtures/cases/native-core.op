{
  "version": "0.8.0",
  "children": [
    {
      "type": "frame",
      "id": "button_primary",
      "name": "button_primary",
      "reusable": true,
      "width": 160,
      "height": 44,
      "cornerRadius": 8,
      "layout": "horizontal",
      "justifyContent": "center",
      "alignItems": "center",
      "fill": [{ "type": "solid", "color": "#2563eb" }],
      "children": [
        {
          "type": "text",
          "id": "button_primary_label",
          "content": "Play",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": 400,
          "fill": [{ "type": "solid", "color": "#ffffff" }]
        }
      ]
    },
    {
      "type": "frame",
      "id": "artboard",
      "name": "artboard",
      "x": 0,
      "y": 0,
      "width": 1280,
      "height": 720,
      "fill": [{ "type": "solid", "color": "#0f172a" }],
      "children": [
        {
          "type": "frame",
          "id": "main_menu",
          "name": "main_menu",
          "width": "fill_container",
          "height": "fill_container",
          "layout": "vertical",
          "justifyContent": "center",
          "alignItems": "center",
          "gap": 16,
          "padding": 32,
          "children": [
            {
              "type": "text",
              "id": "main_menu.title",
              "name": "main_menu.title",
              "width": "fit_content",
              "height": "fit_content",
              "content": "REGICIDE",
              "fontFamily": "Inter",
              "fontSize": 48,
              "fontWeight": 400,
              "fill": [{ "type": "solid", "color": "#cbd5e1" }]
            },
            {
              "type": "ref",
              "id": "main_menu.play",
              "name": "main_menu.play",
              "ref": "button_primary"
            },
            {
              "type": "frame",
              "id": "banner",
              "width": "50%",
              "height": 48,
              "cornerRadius": 8,
          "fill": [{ "type": "solid", "color": "#7c3aed" }]
            },
            {
              "type": "image",
              "id": "crest",
              "width": 64,
              "height": 64,
              "src": "../icon.png"
            },
            {
              "type": "frame",
              "id": "slot_a",
              "width": 56,
              "height": 56,
              "cornerRadius": 6,
              "fill": [{ "type": "solid", "color": "#1e293b" }]
            }
          ]
        }
      ]
    }
  ]
}
